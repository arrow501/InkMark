{
  "name": "InkMark",
  "short_name": "InkMark",
  "description": "A markdown editor you can ink directly over.",
  "start_url": "./inkmark.html",
  "scope": "./",
  "id": "/inkmark/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#faf9f5",
  "theme_color": "#cc785c",
  "categories": ["productivity", "utilities"],
  "icons": [
    {
      "src": "./icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "./icon-maskable.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "./inkmark.html",
      "accept": {
        "text/markdown": [".md", ".markdown", ".mdown", ".mkd"],
        "text/plain": [".txt"]
      },
      "icons": [
        { "src": "./icon.svg", "sizes": "any", "type": "image/svg+xml" }
      ],
      "launch_type": "single-client"
    }
  ],
  "shortcuts": [
    {
      "name": "New document",
      "short_name": "New",
      "url": "./inkmark.html?new=1",
      "icons": [{ "src": "./icon.svg", "sizes": "any", "type": "image/svg+xml" }]
    }
  ]
}
